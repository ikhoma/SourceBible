# ── Generated database ────────────────────────────────────────
sourcebible.db
sourcebible.db-wal
sourcebible.db-shm

# Bundled DB in Resources — generated, not source-controlled (149 MB)
SourceBible/Resources/sourcebible.db

# Local DB backups (sqlite .backup copies, ~150–190 MB each — never commit,
# exceed GitHub's 100 MB limit and cause push rejection)
backups/

# ── Datasets (large / licensed — download manually, see docs/BUILD.md) ──
data/*
scripts/.cache/

# EXCEPTION: versification build inputs are small (MIT .vrs) and curated
# (overrides.tsv = hand-derived mapping decisions, ADR-028) — MUST be tracked,
# else a fresh checkout loses them and the build is not reproducible.
!data/versification/
!data/versification/**

# EXCEPTION: curated gloss overrides are small and hand-derived (bug-051) —
# MUST be tracked, else a fresh checkout silently loses them: process_glosses.py
# treats a missing file as "{}" (no error), empty slots regress 160→307, and
# rebuild.sh hard-fails later at check_gloss_coverage.py's budget gate instead.
!data/glosses/
!data/glosses/**

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Xcode ─────────────────────────────────────────────────────
xcuserdata/
*.xcuserstate
*.xcbkptlist
DerivedData/
*.hmap
*.ipa
*.xcarchive
.build/

# Shared schemes are committed; user-specific data is not
SourceBible.xcodeproj/xcuserdata/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# ── Misc ──────────────────────────────────────────────────────
*.log
*.bak
.env

# ── FUSE / sparse-file artifacts ──────────────────────────────
# Created during APFS sparse-file operations (e.g. DB copy via FUSE).
.fuse_hidden*

# ── Analytics secrets (never commit real tokens) ──────────────
Config/Secrets.xcconfig

# ── Generated files (overwritten at build time, never commit) ──
SourceBible/Generated/AnalyticsConfiguration.swift

# ── Local workflow scripts ─────────────────────────────────────
commit_all.sh

# ── Scratch / broken copies awaiting deletion ─────────────────
# Two byte-identical broken copies of make_gold_entry_page.py landed here
# 2026-08; ignored rather than deleted (reversible). Delete by hand when sure.
scripts/_to_delete/
SourceBible/Resources/sourcebible-backup.db
sb_baseline.db*
