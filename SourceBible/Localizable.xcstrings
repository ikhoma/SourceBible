    "analytics.consent.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymous usage stats show which features people use, so we know what to improve. Notes, highlights, and search queries are never shared. You can change this any time in the Menu, details in the [Privacy Policy](https://source-bible.vercel.app/privacy)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анонімна статистика показує, якими функціями користуються, і так видно, що покращувати. Нотатки, виділення й пошукові запити не передаються ніколи. Рішення можна змінити будь-коли в Меню, деталі в [Політиці конфіденційності](https://source-bible.vercel.app/privacy)."
          }
        }
      }
    },
    "analytics.consent.decline" : {
      "localizations" : {
        "en" : {
