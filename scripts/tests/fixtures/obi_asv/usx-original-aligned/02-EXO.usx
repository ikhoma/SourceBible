	<para style="p"><verse number="5" style="v" x-ref="EXO.12.5" x-added-alignments="EXO.12.5.a016" x-added-target-ids="t015" x-added-target="it" sid="EXO 12:5" /><char style="w" x-id="WLC.EXO.12.5.001" x-align="EXO.12.5.a001" x-target-ids="t002" x-target="lamb" x-target-head="t002" x-head="true" lemma="שֶׂה" strong="H7716" x-morph="Ncbsa" x-gloss="a.lamb" x-translit="śeh" xml:lang="hbo">שֶׂ֥ה</char> <char style="w" x-id="WLC.EXO.12.5.002" x-align="EXO.12.5.a002" x-target-ids="t005 t006" x-target="without blemish" x-target-head="t006" x-head="true" lemma="תָּמִים" strong="H8549" x-morph="Aamsa" x-gloss="unblemished" x-translit="ṯāmiym" xml:lang="hbo">תָמִ֛ים</char> <char style="w" x-id="WLC.EXO.12.5.003" x-align="EXO.12.5.a003" x-target-ids="t007 t008" x-target="a male" x-target-head="t008" x-head="true" lemma="זָכָר" strong="H2145" x-morph="Aamsa" x-gloss="male" x-translit="zāḵār" xml:lang="hbo">זָכָ֥ר</char> <char style="w" x-id="WLC.EXO.12.5.004" x-align="EXO.12.5.a004" x-status="noncompositional" x-target-ids="t009 t010 t011" x-target="a year old" x-target-head="t010" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="a.son" x-translit="ben-" xml:lang="hbo">בֶּן</char>־<char style="w" x-id="WLC.EXO.12.5.005" x-align="EXO.12.5.a004" x-status="noncompositional" lemma="שָׁנָה" strong="H8141" x-morph="Ncfsa" x-gloss="of.a.year" x-translit="šānāh" xml:lang="hbo">שָׁנָ֖ה</char> <char style="w" x-id="WLC.EXO.12.5.006" x-align="EXO.12.5.a005" x-target-ids="t003 t004" x-target="shall be" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi3ms" x-gloss="it.will.be" x-translit="yihyeh" xml:lang="hbo">יִהְיֶ֣ה</char> <char style="w" x-id="WLC.EXO.12.5.007" x-align="EXO.12.5.a006" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="l" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.EXO.12.5.008" x-align="EXO.12.5.a007" x-target-ids="t001" x-target="Your" x-target-head="t001" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="you" x-translit="āḵem" xml:lang="hbo">כֶ֑ם</char> <char style="w" x-id="WLC.EXO.12.5.009" x-align="EXO.12.5.a008" x-target-ids="t016" x-target="from" x-target-head="t016" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="one.of" x-translit="min-" xml:lang="hbo">מִן</char>־<char style="w" x-id="WLC.EXO.12.5.010" x-align="EXO.12.5.a009" x-target-ids="t017" x-target="the" x-target-head="t017" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.EXO.12.5.011" x-align="EXO.12.5.a010" x-target-ids="t018" x-target="sheep" x-target-head="t018" x-head="true" lemma="כֶּבֶשׂ" strong="H3532" x-morph="Ncmpa" x-gloss="lambs" x-translit="kəḇāśiym" xml:lang="hbo">כְּבָשִׂ֥ים</char> <char style="w" x-id="WLC.EXO.12.5.012" x-align="EXO.12.5.a011" x-target-ids="t019" x-target="or" x-target-head="t019" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.EXO.12.5.013" x-align="EXO.12.5.a012" x-target-ids="t020" x-target="from" x-target-head="t020" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="one.of" x-translit="min-" xml:lang="hbo">מִן</char>־<char style="w" x-id="WLC.EXO.12.5.014" x-align="EXO.12.5.a013" x-target-ids="t021" x-target="the" x-target-head="t021" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.EXO.12.5.015" x-align="EXO.12.5.a014" x-target-ids="t022" x-target="goats" x-target-head="t022" x-head="true" lemma="עֵז" strong="H5795" x-morph="Ncfpa" x-gloss="goats" x-translit="ʿizziym" xml:lang="hbo">עִזִּ֖ים</char> <char style="w" x-id="WLC.EXO.12.5.016" x-align="EXO.12.5.a015" x-target-ids="t012 t013 t014" x-target="ye shall take" x-target-head="t014" x-head="true" lemma="לָקַח" strong="H3947" x-morph="Vqi2mp" x-gloss="you.will.take" x-translit="tiq