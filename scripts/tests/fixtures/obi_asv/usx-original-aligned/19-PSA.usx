	<para style="d" x-ref="PSA.3.0"><char style="w" x-id="WLC.PSA.3.0.001" x-align="PSA.3.0.a001" x-target-ids="t001 t002" x-target="A Psalm" x-target-head="t002" x-head="true" lemma="מִזְמוֹר" strong="H4210" x-morph="Ncmsa" x-gloss="a.psalm" x-translit="mizmôr" xml:lang="hbo" x-source-ref="PSA.3.1">מִזְמ֥וֹר</char> <char style="w" x-id="WLC.PSA.3.0.002" x-align="PSA.3.0.a002" x-target-ids="t003" x-target="of" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.3.1">לְ</char><char style="w" x-id="WLC.PSA.3.0.003" x-align="PSA.3.0.a003" x-target-ids="t004" x-target="David" x-target-head="t004" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="David" x-translit="ḏāwiḏ" xml:lang="hbo" x-source-ref="PSA.3.1">דָוִ֑ד</char> <char style="w" x-id="WLC.PSA.3.0.004" x-align="PSA.3.0.a004" x-target-ids="t005" x-target="when" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.3.1">בְּ֝</char><char style="w" x-id="WLC.PSA.3.0.005" x-align="PSA.3.0.a005" x-target-ids="t007" x-target="fled" x-target-head="t007" x-head="true" lemma="בָּרַח" strong="H1272" x-morph="Vqc" x-gloss="fled" x-translit="ḇārəḥ" xml:lang="hbo" x-source-ref="PSA.3.1">בָרְח֗</char><char style="w" x-id="WLC.PSA.3.0.006" x-align="PSA.3.0.a006" x-target-ids="t006" x-target="he" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="he" x-translit="ô" xml:lang="hbo" x-source-ref="PSA.3.1">וֹ</char> <char style="w" x-id="WLC.PSA.3.0.007" x-align="PSA.3.0.a007" x-target-ids="t008" x-target="from" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.3.1">מִ</char><char style="w" x-id="WLC.PSA.3.0.008" x-align="PSA.3.0.a008" x-status="unrepresented" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="bef