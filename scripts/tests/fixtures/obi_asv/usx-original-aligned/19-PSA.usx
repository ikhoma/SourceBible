	<para style="p"><verse number="2" style="v" x-ref="PSA.3.2" sid="PSA 3:2" /><char style="w" x-id="WLC.PSA.3.2.001" x-align="PSA.3.2.a001" x-target-ids="t001" x-target="Many" x-target-head="t001" x-head="true" lemma="רַב" strong="H7227" x-morph="Aampa" x-gloss="many.[people]" x-translit="rabbîm" xml:lang="hbo" x-source-ref="PSA.3.3">רַבִּים֮</char> <char style="w" x-id="WLC.PSA.3.2.002" x-align="PSA.3.2.a002" x-target-ids="t002 t003 t004 t005" x-target="there are that say" x-target-head="t005" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqrmpa" x-gloss="[are].saying" x-translit="ʾōməriym" xml:lang="hbo" x-source-ref="PSA.3.3">אֹמְרִ֪ים</char> <char style="w" x-id="WLC.PSA.3.2.003" x-align="PSA.3.2.a003" x-target-ids="t006" x-target="of" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.3.3">לְ</char><char style="w" x-id="WLC.PSA.3.2.004" x-align="PSA.3.2.a004" x-target-ids="t008" x-target="soul" x-target-head="t008" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo" x-source-ref="PSA.3.3">נַ֫פְשִׁ֥</char><char style="w" x-id="WLC.PSA.3.2.005" x-align="PSA.3.2.a005" x-target-ids="t007" x-target="my" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.3.3">י</char> <char style="w" x-id="WLC.PSA.3.2.006" x-align="PSA.3.2.a006" x-target-ids="t009 t010 t011" x-target="There is no" x-target-head="t011" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾēyn" xml:lang="hbo" x-source-ref="PSA.3.3">אֵ֤ין</char> <char style="w" x-id="WLC.PSA.3.2.007" x-align="PSA.3.2.a007" x-target-ids="t012" x-target="help" x-target-head="t012" x-head="true" lemma="יְשׁוּעָה" strong="H3444" x-morph="Ncfsa" x-gloss="deliverance" x-translit="yəšûʿāṯ" xml:lang="hbo" x-source-ref="PSA.3.3">יְֽשׁוּעָ֓תָ</char><char styl