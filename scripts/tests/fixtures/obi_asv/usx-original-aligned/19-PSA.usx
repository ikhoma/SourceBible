	<para style="p"><verse number="1" style="v" x-ref="PSA.3.1" sid="PSA 3:1" /><char style="w" x-id="WLC.PSA.3.1.001" x-align="PSA.3.1.a001" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yhwh" xml:lang="hbo" x-source-ref="PSA.3.2">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.3.1.002" x-align="PSA.3.1.a002" x-target-ids="t002" x-target="how" x-target-head="t002" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="how!" x-translit="māh-" xml:lang="hbo" x-source-ref="PSA.3.2">מָֽה</char>־<char style="w" x-id="WLC.PSA.3.1.003" x-align="PSA.3.1.a003" x-target-ids="t003 t006" x-target="are increased" x-target-head="t006" x-head="true" lemma="רָבַב" strong="H7231" x-morph="Vqp3cp" x-gloss="they.are.many" x-translit="rabû" xml:lang="hbo" x-source-ref="PSA.3.2">רַבּ֣וּ</char> <char style="w" x-id="WLC.PSA.3.1.004" x-align="PSA.3.1.a004" x-target-ids="t005" x-target="adversaries" x-target-head="t005" x-head="true" lemma="צַר" strong="H6862a" x-morph="Ncmpc" x-gloss="foes" x-translit="ṣār" xml:lang="hbo" x-source-ref="PSA.3.2">צָרָ֑</char><char style="w" x-id="WLC.PSA.3.1.005" x-align="PSA.3.1.a005" x-target-ids="t004" x-target="mine" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo" x-source-ref="PSA.3.2">י</char> <char style="w" x-id="WLC.PSA.3.1.006" x-align="PSA.3.1.a006" x-target-ids="t007 t008" x-target="Many are" x-target-head="t007" x-head="true" lemma="רַב" strong="H7227" x-morph="Aampa" x-gloss="many.[people]" x-translit="rabbiym" xml:lang="hbo" x-source-ref="PSA.3.2">רַ֝בִּ֗ים</char> <char style="w" x-id="WLC.PSA.3.1.007" x-align="PSA.3.1.a007" x-target-ids="t009 t010 t011 t012" x-target="they that rise up" x-target-head="t011" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqrmpa" x-gloss="[are].rising.up" x-translit="qāmiym" xml:lang="hbo" x-source-ref="PSA.3.2">קָמִ֥ים</char> <ch