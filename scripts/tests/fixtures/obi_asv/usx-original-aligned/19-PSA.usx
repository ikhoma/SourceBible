	<para style="p"><verse number="1" style="v" x-ref="PSA.119.1" sid="PSA 119:1" /><char style="w" x-id="WLC.PSA.119.1.001" x-align="PSA.119.1.a001" x-target-ids="t001 t002" x-target="Blessed are" x-target-head="t001" x-head="true" lemma="אֶשֶׁר" strong="H835a" x-morph="Ncmpa" x-gloss="how.blessed!" x-translit="ʾašrēy" xml:lang="hbo">אַשְׁרֵ֥י</char> <char style="w" x-id="WLC.PSA.119.1.002" x-align="PSA.119.1.a002" x-target-ids="t003 t004 t005 t006" x-target="they that are perfect" x-target-head="t006" x-head="true" lemma="תָּמִים" strong="H8549" x-morph="Aampc" x-gloss="[are.people].blameless" x-translit="ṯəmiymê-" xml:lang="hbo">תְמִֽימֵי</char>־<char style="w" x-id="WLC.PSA.119.1.003" x-align="PSA.119.1.a003" x-target-ids="t007 t008 t009" x-target="in the way" x-target-head="t009" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsa" x-gloss="of.way" x-translit="ḏāreḵ" xml:lang="hbo">דָ֑רֶךְ</char> <char style="w" x-id="WLC.PSA.119.1.004" x-align="PSA.119.1.a004" x-target-ids="t010" x-target="Who" x-target-head="t010" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[who]" x-translit="ha" xml:lang="hbo">הַֽ֝</char><char style="w" x-id="WLC.PSA.119.1.005" x-align="PSA.119.1.a005" x-target-ids="t011" x-target="walk" x-target-head="t011" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqrmpa" x-gloss="walk" x-translit="hōləḵiym" xml:lang="hbo">הֹלְכִ֗ים</char> <char style="w" x-id="WLC.PSA.119.1.006" x-align="PSA.119.1.a006" x-target-ids="t012" x-target="in" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.119.1.007" x-align="PSA.119.1.a007" x-target-ids="t013 t014" x-target="the law" x-target-head="t014" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfsc" x-gloss="the.law" x-translit="ṯôraṯ" xml:lang="hbo">תוֹרַ֥ת</char> <char style="w" x-id="WLC.PSA.119.1.008" x-align="PSA.119.1.a008" x-target-ids="t015 t016" x-target="of Jehovah" x-target-head="t016" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh:" xml:lang="hbo">יְהוָֽה</char>׃<verse eid="PSA 119:1" /></para>
	<para style="p"><verse number="9" style="v" x-ref="PSA.119.9" sid="PSA 119:9" /><char style="w" x-id="WLC.PSA.119.9.001" x-align="PSA.119.9.a001" lemma="בְּ" strong="H871a" x-morph="R" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.PSA.119.9.002" x-align="PSA.119.9.a001" x-target-ids="t001" x-target="Wherewith" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="how?" x-translit="mmeh" xml:lang="hbo">מֶּ֣ה</char> <char style="w" x-id="WLC.PSA.119.9.003" x-align="PSA.119.9.a002" x-target-ids="t002 t006" x-target="shall cleanse" x-target-head="t006" x-head="true" lemma="זָכָה" strong="H2135" x-morph="Vpi3ms" x-gloss="will.he.keep.pure" x-translit="yəzakkeh-" xml:lang="hbo">יְזַכֶּה</char>־<char style="w" x-id="WLC.PSA.119.9.004" x-align="PSA.119.9.a003" x-target-ids="t003 t004 t005" x-target="a young man" x-target-head="t004" x-head="true" lemma="נַעַר" strong="H5288" x-morph="Ncmsa" x-gloss="a.youth" x-translit="nnaʿar" xml:lang="hbo">נַּ֭עַר</char> <char style="w" x-id="WLC.PSA.119.9.005" x-align="PSA.119.9.a004" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PSA.119.9.006" x-align="PSA.119.9.a005" x-target-ids="t008" x-target="way" x-target-head="t008" x-head="true" lemma="אֹרַח" strong="H734" x-morph="Ncbsc" x-gloss="path" x-translit="ʾārəḥ" xml:lang="hbo">אָרְח֑</char><char style="w" x-id="WLC.PSA.119.9.007" x-align="PSA.119.9.a006" x-target-ids="t007" x-target="his" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.119.9.008" x-align="PSA.119.9.a007" x-target-ids="t009" x-target="By" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="by" x-translit="li" xml:lang="hbo">לִ֝</char><char style="w" x-id="WLC.PSA.119.9.009" x-align="PSA.119.9.a008" x-target-i