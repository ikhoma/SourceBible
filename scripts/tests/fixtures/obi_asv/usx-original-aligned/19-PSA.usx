	<para style="p"><verse number="4" style="v" x-ref="PSA.23.4" sid="PSA 23:4" /><char style="w" x-id="WLC.PSA.23.4.001" x-align="PSA.23.4.a001" x-target-ids="t001" x-target="Yea" x-target-head="t001" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam" xml:lang="hbo">גַּ֤ם</char> <char style="w" x-id="WLC.PSA.23.4.002" x-align="PSA.23.4.a002" x-target-ids="t002" x-target="though" x-target-head="t002" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PSA.23.4.003" x-align="PSA.23.4.a003" x-target-ids="t003 t004" x-target="I walk" x-target-head="t004" x-head="true" lemma="הלך" strong="H1980" x-morph="Vqi1cs" x-gloss="I.will.go" x-translit="ʾēlēḵ" xml:lang="hbo">אֵלֵ֨ךְ</char> <char style="w" x-id="WLC.PSA.23.4.004" x-align="PSA.23.4.a004" x-target-ids="t005" x-target="through" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.23.4.005" x-align="PSA.23.4.a005" x-target-ids="t006 t007" x-target="the valley" x-target-head="t007" x-head="true" lemma="גַּיְא" strong="H1516" x-morph="Ncbsc" x-gloss="a.valley" x-translit="ḡēyʾ" xml:lang="hbo">גֵ֪יא</char> <char style="w" x-id="WLC.PSA.23.4.006" x-align="PSA.23.4.a006" x-target-ids="t008 t009 t010 t011 t012" x-target="of the shadow of death" x-target-head="t010" x-head="true" lemma="צַלְמָוֶת" strong="H6757" x-morph="Ncmsa" x-gloss="of.deep.darkness" x-translit="ṣalmāweṯ" xml:lang="hbo">צַלְמָ֡וֶת</char> <char style="w" x-id="WLC.PSA.23.4.007" x-align="PSA.23.4.a007" x-target-ids="t016" x-target="no" x-target-head="t016" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PSA.23.4.008" x-align="PSA.23.4.a008" x-target-ids="t013 t014 t015" x-target="I will fear" x-target-head="t015" x-head="true" lemma="יָרֵא" stro