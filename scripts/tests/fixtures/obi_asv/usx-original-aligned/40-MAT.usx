	<para style="p"><verse number="26" style="v" x-ref="MAT.26.26" sid="MAT 26:26" /><char style="w" x-id="SBLGNT.MAT.26.26.001" x-align="MAT.26.26.a001" x-target-ids="t002 t004 t005" x-target="as were eating" x-target-head="t005" x-head="true" lemma="ἐσθίω" strong="G2068" x-morph="V-PAP-GPM" x-gloss="[As] they were eating" x-translit="Esthiontōn" xml:lang="grc">Ἐσθιόντων</char> <char style="w" x-id="SBLGNT.MAT.26.26.002" x-align="MAT.26.26.a002" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.MAT.26.26.003" x-align="MAT.26.26.a003" x-target-ids="t003" x-target="they" x-target-head="t003" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GPM" x-gloss="of them" x-translit="autōn" xml:lang="grc">αὐτῶν</char> <char style="w" x-id="SBLGNT.MAT.26.26.004" x-align="MAT.26.26.a004" x-target-ids="t007" x-target="took" x-target-head="t007" x-head="true" lemma="λαμβάνω" strong="G2983" x-morph="V-2AAP-NSM" x-gloss="having taken" x-translit="labōn" xml:lang="grc">λαβὼν</char> <char style="w" x-id="SBLGNT.MAT.26.26.005" x-align="MAT.26.26.a005" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.MAT.26.26.006" x-align="MAT.26.26.a006" x-target-ids="t006" x-target="Jesus" x-target-head="t006" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-NSM" x-gloss="Jesus" x-translit="Iēsous" xml:lang="grc">Ἰησοῦς</char> <char style="w" x-id="SBLGNT.MAT.26.26.007" x-align="MAT.26.26.a007" x-target-ids="t008" x-target="bread" x-target-head="t008" x-head="true" lemma="ἄρτος" strong="G740" x-morph="N-ASM" x-gloss="bread" x-translit="arton" xml:lang="grc">ἄρτον</char> <char style="w" x-id="SBLGNT.MAT.26.26.008" x-align="MAT.26.26.a008" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.26.26.009" x-align="MAT.26.26.a009" x-target-ids="t010" x-target="blessed" x-target-head="t010" x-head="true" lemma="εὐλογέω" strong="G2127" x-morph="V-AAP-NSM" x-gloss="having blessed" x-translit="eulogēsas" xml:lang="grc">εὐλογήσας</char> <char style="w" x-id="SBLGNT.MAT.26.26.010" x-align="MAT.26.26.a010" x-target-ids="t011 t012 t013" x-target="and brake it" x-target-head="t012" x-head="true" lemma="κλάω" strong="G2806" x-morph="V-AAI-3S" x-gloss="broke [it]" x-translit="eklasen" xml:lang="grc">ἔκλασεν</char> <char style="w" x-id="SBLGNT.MAT.26.26.011" x-align="MAT.26.26.a011" x-target-ids="t014" x-target="and" x-target-head="t014" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.26.26.012" x-align="MAT.26.26.a012" x-target-ids="t015 t016" x-target="he gave" x-target-head="t016" x-head="true" lemma="δίδωμι" strong="G1325" x-morph="V-2AAP-NSM" x-gloss="having given" x-translit="dous" xml:lang="grc">δοὺς</char> <char style="w" x-id="SBLGNT.MAT.26.26.013" x-align="MAT.26.26.a013" x-target-ids="t017 t018" x-target="to the" x-target-head="t018" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DPM" x-gloss="to the" x-translit="tois" xml:lang="grc">τοῖς</char> <char style="w" x-id="SBLGNT.MAT.26.26.014" x-align="MAT.26.26.a014" x-target-ids="t019" x-target="disciples" x-target-head="t019" x-head="true" lemma="μαθητής" strong="G3101" x-morph="N-DPM" x-gloss="disciples" x-translit="mathētais" xml:lang="grc">μαθηταῖς</char> <char style="w" x-id="SBLGNT.MAT.26.26.015" x-align="MAT.26.26.a015" x-target-ids="t020 t021" x-target="and said" x-target-head="t021" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="He said" x-translit="eipen" xml:lang="grc">εἶπεν</char>·<char style="w" x-id="SBLGNT.MAT.26.26.016" x-align="MAT.26.26.a016" x-target-ids="t022" x-target="Take" x-target-head="t022" x-head="true" lemma="λαμβάνω" strong="G2983" x-morph="V-2AAM-2P" x-gloss="Take" x-translit="Labete" xml:lang="grc">Λάβετε</char> <char style="w" x-id="SBLGNT.MAT.26.26.017" x-align="MAT.26.26.a017" x-target-ids="t023" x-target="eat" x-target-head="t023" x-head="true" lemma="ἐσθίω" strong="G5315" x-morph="V-2AAM-2P" x-gloss="eat" x-translit="phagete" xml:lang="grc">φάγετε</char>,<char style="w" x-id="SBLGNT.MAT.26.26.018" x-align="MAT.26.26.a018" x-target-ids="t024" x-target="this" x-target-head="t024" x-head="true" lemma="οὗτος" strong="G5124" x-morph="D-NSN" x-gloss="this" x-translit="touto" xml:lang="grc">τοῦτό</char> <char style="w" x-id="SBLGNT.MAT.26.26.019" x-align="MAT.26.26.a019" x-target-ids="t025" x-target="is" x-target-head="t025" x-head="true" lemma="εἰμί" strong="G2076" x-morph="V-PAI-3S" x-gloss="is" x-translit="estin" xml:lang="grc">ἐστιν</char> <char style="w" x-id="SBLGNT.MAT.26.26.020" x-align="MAT.26.26.a020" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.MAT.26.26.021" x-align="MAT.26.26.a021" x-target-ids="t027" x-target="body" x-target-head="t027" x-head="true" lemma="σῶμα" strong="G4983" x-morph="N-NSN" x-gloss="body" x-translit="sōma" xml:lang="grc">σῶμά</char> <char style="w" x-id="SBLGNT.MAT.26.26.022" x-align="MAT.26.26.a022" x-target-ids="t026" x-target="my" x-target-head="t026" x-head="true" lemma="ἐγώ" strong="G3450" x-morph="P-1GS" x-gloss="of Me" x-translit="mou" xml:lang="grc">μου</char>.<verse eid="MAT 26:26" /></para>
