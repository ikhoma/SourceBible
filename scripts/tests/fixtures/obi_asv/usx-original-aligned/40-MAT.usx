	<para style="p"><verse number="13" style="v" x-ref="MAT.6.13" sid="MAT 6:13" /><char style="w" x-id="SBLGNT.MAT.6.13.001" x-align="MAT.6.13.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.6.13.002" x-align="MAT.6.13.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.MAT.6.13.003" x-align="MAT.6.13.a003" x-target-ids="t002" x-target="bring" x-target-head="t002" x-head="true" lemma="εἰσφέρω" strong="G1533" x-morph="V-AAS-2S" x-gloss="lead" x-translit="eisenenkēis" xml:lang="grc">εἰσενέγκῃς</char> <char style="w" x-id="SBLGNT.MAT.6.13.004" x-align="MAT.6.13.a004" x-target-ids="t003" x-target="us" x-target-head="t003" x-head="true" lemma="ἐγώ" strong="G2248" x-morph="P-1AP" x-gloss="us" x-translit="hēmas" xml:lang="grc">ἡμᾶς</char> <char style="w" x-id="SBLGNT.MAT.6.13.005" x-align="MAT.6.13.a005" x-target-ids="t005" x-target="into" x-target-head="t005" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="into" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.MAT.6.13.006" x-align="MAT.6.13.a006" x-target-ids="t006" x-target="temptation" x-target-head="t006" x-head="true" lemma="πειρασμός" strong="G3986" x-morph="N-ASM" x-gloss="temptation" x-translit="peirasmon" xml:lang="grc">πειρασμόν</char>,<char style="w" x-id="SBLGNT.MAT.6.13.007" x-align="MAT.6.13.a007" x-target-ids="t007" x-target="but" x-target-head="t007" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="but" x-translit="alla" xml:lang="grc">ἀλλὰ</char> <char style="w" x-id="SBLGNT.MAT.6.13.008" x-align="MAT.6.13.a008" x-target-ids="t008" x-target="deliver" x-target-head="t008" x-head="true" lemma="ῥύομαι" strong="G4506" x-morph="V-ADM-2S" x-gloss="delive