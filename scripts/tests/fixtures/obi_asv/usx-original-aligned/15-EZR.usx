	<para style="p"><verse number="8" style="v" x-ref="EZR.4.8" sid="EZR 4:8" /><char style="w" x-id="WLC.EZR.4.8.001" x-align="EZR.4.8.a001" x-target-ids="t001" x-target="Rehum" x-target-head="t001" x-head="true" lemma="רְחוּם" strong="H7348a" x-morph="Np" x-gloss="Rehum" x-translit="rəḥûm" xml:lang="arc">רְח֣וּם</char> <char style="w" x-id="WLC.EZR.4.8.002" x-align="EZR.4.8.a002" x-status="noncompositional" x-target-ids="t002 t003" x-target="the chancellor" x-target-head="t003" x-head="true" lemma="בְּעֵל" strong="H1169" x-morph="Ncmsc" x-gloss="lord" x-translit="bəʿēl-" xml:lang="arc">בְּעֵל</char>־<char style="w" x-id="WLC.EZR.4.8.003" x-align="EZR.4.8.a002" x-status="noncompositional" lemma="טְעֵם" strong="H2942" x-morph="Ncmsa" x-gloss="of.command" x-translit="ṭəʿēm" xml:lang="arc">טְעֵ֗ם</char> <char style="w" x-id="WLC.EZR.4.8.004" x-align="EZR.4.8.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050d" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="arc">וְ</char><char style="w" x-id="WLC.EZR.4.8.005" x-align="EZR.4.8.a004" x-target-ids="t005" x-target="Shimshai" x-target-head="t005" x-head="true" lemma="שִׁמְשַׁי" strong="H8124" x-morph="Np" x-gloss="Shimshai" x-translit="šimšay" xml:lang="arc">שִׁמְשַׁי֙</char> <char style="w" x-id="WLC.EZR.4.8.006" x-align="EZR.4.8.a005" x-target-ids="t007" x-target="scribe" x-target-head="t007" x-head="true" lemma="סָפִר" strong="H5613" x-morph="Ncmsd" x-gloss="the" x-translit="sāp̄ər" xml:lang="arc">סָֽפְרָ֔</char><char style="w" x-id="WLC.EZR.4.8.007" x-align="EZR.4.8.a006" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="א" strong="H1b" x-morph="Td" x-gloss="scribe" x-translit="āʾ" xml:lang="arc">א</char> <char style="w" x-id="WLC.EZR.4.8.008" x-align="EZR.4.8.a007" x-target-ids="t008" x-target="wrote" x-target-head="t008" x-head="true" lemma="כְּתַב" strong="H3790" x-morph="Vqp3mp" x-gloss="they.wrote" x-translit="kəṯaḇû" xml:lang="arc">כְּת