	<para style="p"><verse number="26" style="v" x-ref="EZK.16.26" sid="EZK 16:26" /><char style="w" x-id="WLC.EZK.16.26.001" x-align="EZK.16.26.a001" x-target-ids="t003" x-target="also" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.EZK.16.26.002" x-align="EZK.16.26.a002" x-target-ids="t001 t002 t004 t005" x-target="Thou hast committed fornication" x-target-head="t005" x-head="true" lemma="זָנָה" strong="H2181" x-morph="Vqw2fs" x-gloss="you.acted.as.a.prostitute" x-translit="tizniy" xml:lang="hbo">תִּזְנִ֧י</char> <char style="w" x-id="WLC.EZK.16.26.003" x-align="EZK.16.26.a003" x-target-ids="t006" x-target="with" x-target-head="t006" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.EZK.16.26.004" x-align="EZK.16.26.a004" x-target-ids="t007" x-target="the" x-target-head="t007" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="the.people" x-translit="bənēy-" xml:lang="hbo">בְּנֵֽי</char>־<char style="w" x-id="WLC.EZK.16.26.005" x-align="EZK.16.26.a005" x-target-ids="t008" x-target="Egyptians" x-target-head="t008" x-head="true" lemma="מִצְרַיִם" strong="H4714" x-morph="Np" x-gloss="of.Egypt" x-translit="miṣrayim" xml:lang="hbo">מִצְרַ֛יִם</char> <char style="w" x-id="WLC.EZK.16.26.006" x-align="EZK.16.26.a006" x-target-ids="t010" x-target="neighbors" x-target-head="t010" x-head="true" lemma="שָׁכֵן" strong="H7934" x-morph="Aampc" x-gloss="neighbors" x-translit="šəḵēnay" xml:lang="hbo">שְׁכֵנַ֖יִ</char><char style="w" x-id="WLC.EZK.16.26.007" x-align="EZK.16.26.a007" x-target-ids="t009" x-target="thy" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="your" x-translit="iḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.EZK.16.26.008" x-align="EZK.16.26.a008" x-target-ids="t011" x-target="great" x-target-head="t011" x-head="true" lemma="גָּדֵל" strong="H1432" x-morph="Vqrmpc" x-gloss="[who.were].great" x-translit="giḏlēy" xml:lang="hbo">גִּדְלֵ֣י</char> <char style="w" x-id="WLC.EZK.16.26.009" x-align="EZK.16.26.a009" x-target-ids="t012 t013" x-target="of flesh" x-target-head="t013" x-head="true" lemma="בָּשָׂר" strong="H1320" x-morph="Ncmsa" x-gloss="of.flesh" x-translit="ḇāśār" xml:lang="hbo">בָשָׂ֑ר</char> <char style="w" x-id="WLC.EZK.16.26.010" x-align="EZK.16.26.a010" x-target-ids="t014" x-target="and" x-target-head="t014" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.EZK.16.26.011" x-align="EZK.16.26.a011" x-target-ids="t015 t016" x-target="hast multiplied" x-target-head="t016" x-head="true" lemma="רָבָה" strong="H7235" x-morph="Vhw2fs" x-gloss="you.increased" x-translit="tarbiy" xml:lang="hbo">תַּרְבִּ֥י</char> <char style="w" x-id="WLC.EZK.16.26.012" x-align="EZK.16.26.a012" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.EZK.16.26.013" x-align="EZK.16.26.a013" x-target-ids="t018" x-target="whoredom" x-target-head="t018" x-head="true" lemma="תַּזְנוּת" strong="H8457" x-morph="Ncfsc" x-gloss="prostitution" x-translit="taznuṯ" xml:lang="hbo">תַּזְנֻתֵ֖</char><char style="w" x-id="WLC.EZK.16.26.014" x-align="EZK.16.26.a014" x-target-ids="t017" x-target="thy" x-target-head="t017" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="your" x-translit="ēḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.EZK.16.26.015" x-align="EZK.16.26.a015" x-target-ids="t019" x-target="to" x-target-head="t019" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.EZK.16.26.016" x-align="EZK.16.26.a016" x-target-ids="t020 t022 t023" x-target="provoke to anger" x-target-head="t020" x-head="true" lemma="כָּעַס" strong="H3707" x-morph="Vhc" x-gloss="provoke" x-translit="haḵʿiys" xml:lang="hbo">הַכְעִיסֵֽ</char><char style="w" x-id="WLC.EZK.16.26.017" x-align="EZK.16.26.a017" x-target-ids="t021" x-target="me" x-target-head="t021" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="me.to.anger" x-translit="ēniy" xml:lang="hbo">נִי</char>׃<verse eid="EZK 16:26" /></para>
