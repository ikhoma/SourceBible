	<para style="q1"><verse number="4" style="v" sid="PSA 23:4" /><char style="w" x-id="t001" x-align="PSA.23.4.a001" x-src="WLC.PSA.23.4.001" x-source="גַּ֤ם" x-translit="gam" srcloc="WLC.PSA.23.4.001" x-head="true" lemma="גַּם" strong="H1571">Yea</char>, <char style="w" x-id="t002" x-align="PSA.23.4.a002" x-src="WLC.PSA.23.4.002" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.PSA.23.4.002" x-head="true" lemma="כִּי" strong="H3588">though</char> <char style="w" x-id="t003" x-align="PSA.23.4.a003">I</char> <char style="w" x-id="t004" x-align="PSA.23.4.a003" x-src="WLC.PSA.23.4.003" x-source="אֵלֵ֨ךְ" x-translit="ʾēlēḵ" srcloc="WLC.PSA.23.4.003" x-head="true" lemma="הלך" strong="H1980">walk</char> <char style="w" x-id="t005" x-align="PSA.23.4.a004" x-src="WLC.PSA.23.4.004" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.23.4.004" x-head="true" lemma="בְּ" strong="H871a">through</char> <char style="w" x-id="t006" x-align="PSA.23.4.a005">the</char> <char style="w" x-id="t007" x-align="PSA.23.4.a005" x-src="WLC.PSA.23.4.005" x-source="גֵ֪יא" x-translit="ḡēyʾ" srcloc="WLC.PSA.23.4.005" x-head="true" lemma="גַּיְא" strong="H1516">valley</char> <char style="w" x-id="t008" x-align="PSA.23.4.a006">of</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">deep darkness</char> (and so elsewhere)</char></note><char style="w" x-id="t009" x-align="PSA.23.4.a006">the</char> <char style="w" x-id="t010" x-align="PSA.23.4.a006" x-src="WLC.PSA.23.4.006" x-source="צַלְמָ֡וֶת" x-translit="ṣalmāweṯ" srcloc="WLC.PSA.23.4.006" x-head="true" lemma="צַלְמָוֶת" strong="H6757">shadow</char> <char style="w" x-id="t011" x-align="PSA.23.4.a006">of</char> <char style="w" x-id="t012" x-align="PSA.23.4.a006">death</char>,</para>
	<para style="q1"><char style="w" x-id="t013" x-align="PSA.23.4.a008">I</char> <char style="w" x-id="t014" x-align="PSA.23.4.a008">will</char> <char style="w" x-id="t015" x-align="PSA.23.4.a008" x-src="WLC.PSA.23.4.008" x-source="אִ֘ירָ֤א" x-translit="ʾiyrāʾ" srcloc="WLC.PSA.23.4.008" x-head="true" lemma="יָרֵא" strong="H3372">fear</char> <char style="w" x-id="t016" x-align="PSA.23.4.a007" x-src="WLC.PSA.23.4.007" x-source="לֹא" x-translit="lōʾ-" srcloc="WLC.PSA.23.4.007" x-head="true" lemma="לֹא" strong="H3808">no</char> <char style="w" x-id="t017" x-align="PSA.23.4.a009" x-src="WLC.PSA.23.4.009" x-source="רָ֗ע" x-translit="rāʿ" srcloc="WLC.PSA.23.4.009" x-head="true" lemma="רַע" strong="H7451">evil</char>; <char style="w" x-id="t018" x-align="PSA.23.4.a010" x-src="WLC.PSA.23.4.010" x-source="כִּי" x-translit="kî-" srcloc="WLC.PSA.23.4.010" x-head="true" lemma="כִּי" strong="H3588">for</char> <char style="w" x-id="t019" x-align="PSA.23.4.a011" x-src="WLC.PSA.23.4.011" x-source="אַתָּ֥ה" x-translit="ʾattāh" srcloc="WLC.PSA.23.4.011" x-head="true" lemma="אַתָּה" strong="H859">thou</char> <char style="w" x-id="t020" x-align="PSA.23.4.a012">art</char> <char style="w" x-id="t021" x-align="PSA.23.4.a012" x-src="WLC.PSA.23.4.012" x-source="עִמָּדִ֑" x-translit="ʿimmāḏ" srcloc="WLC.PSA.23.4.012" x-head="true" lemma="עִמָּד" strong="H5978">with</char> <char style="w" x-id="t022" x-align="PSA.23.4.a013" x-src="WLC.PSA.23.4.013" x-source="י" x-translit="iy" srcloc="WLC.PSA.23.4.013" x-head="true" lemma="הוּא" strong="H2967a">me</char>;</para>
	<para style="q1"><char style="w" x-id="t023" x-align="PSA.23.4.a015" x-src="WLC.PSA.23.4.015" x-source="ךָ֥" x-translit="əḵā" srcloc="WLC.PSA.23.4.015" x-head="true" lemma="הוּא" strong="H3509b">Thy</char> <char style="w" x-id="t024" x-align="PSA.23.4.a014" x-src="WLC.PSA.23.4.014" x-source="שִׁבְטְ" x-translit="šiḇṭ" srcloc="WLC.PSA.23.4.014" x-head="true" lemma="שֵׁבֶט" strong="H7626">rod</char> <char style="w" x-id="t025" x-align="PSA.23.4.a016" x-src="WLC.PSA.23.4.016" x-source="וּ֝" x-translit="û" srcloc="WLC.PSA.23.4.016" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t026" x-align="PSA.23.4.a018" x-src="WLC.PSA.23.4.018" x-source="ךָ" x-translit="eḵā" srcloc="WLC.PSA.23.4.018" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t027" x-align="PSA.23.4.a017" x-src="WLC.PSA.23.4.017" x-source="מִשְׁעַנְתֶּ֗" x-translit="mišʿant" srcloc="WLC.PSA.23.4.017" x-head="true" lemma="מִשְׁעֶנֶת" strong="H4938a">staff</char>, <char style="w" x-id="t028" x-align="PSA.23.4.a019" x-src="WLC.PSA.23.4.019" x-source="הֵ֣מָּה" x-translit="hēmmâ" srcloc="WLC.PSA.23.4.019" x-head="true" lemma="הֵמָּה" strong="H1992">they</char> <char style="w" x-id="t029" x-align="PSA.23.4.a020" x-src="WLC.PSA.23.4.020" x-source="יְנַֽחֲמֻֽ" x-translit="yənaḥămu" srcloc="WLC.PSA.23.4.020" x-head="true" lemma="נָחַם" strong="H5162">comfort</char> <char style="w" x-id="t030" x-align="PSA.23.4.a021" x-src="WLC.PSA.23.4.021" x-source="נִי" x-translit="niy" srcloc="WLC.PSA.23.4.021" x-head="true" lemma="הוּא" strong="H5204a">me</char>.<verse eid="PSA 23:4" /></para>
