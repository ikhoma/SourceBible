	<chapter number="119" style="c" sid="PSA 119" />
	<para style="s1"><verse number="1" style="v" sid="PSA 119:1" />Meditations and prayers relating to the law of God.</para>
	<para style="qa">א Aleph.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.119.1.a001" x-src="WLC.PSA.119.1.001" x-source="אַשְׁרֵ֥י" x-translit="ʾašrēy" srcloc="WLC.PSA.119.1.001" x-head="true" lemma="אֶשֶׁר" strong="H835a">Blessed</char> <char style="w" x-id="t002" x-align="PSA.119.1.a001">are</char> <char style="w" x-id="t003" x-align="PSA.119.1.a002">they</char> <char style="w" x-id="t004" x-align="PSA.119.1.a002">that</char> <char style="w" x-id="t005" x-align="PSA.119.1.a002">are</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">upright in way</char></char></note><char style="w" x-id="t006" x-align="PSA.119.1.a002" x-src="WLC.PSA.119.1.002" x-source="תְמִֽימֵי" x-translit="ṯəmiymê-" srcloc="WLC.PSA.119.1.002" x-head="true" lemma="תָּמִים" strong="H8549">perfect</char> <char style="w" x-id="t007" x-align="PSA.119.1.a003">in</char> <char style="w" x-id="t008" x-align="PSA.119.1.a003">the</char> <char style="w" x-id="t009" x-align="PSA.119.1.a003" x-src="WLC.PSA.119.1.003" x-source="דָ֑רֶךְ" x-translit="ḏāreḵ" srcloc="WLC.PSA.119.1.003" x-head="true" lemma="דֶּרֶךְ" strong="H1870">way</char>,</para>
	<para style="q1"><char style="w" x-id="t010" x-align="PSA.119.1.a004" x-src="WLC.PSA.119.1.004" x-source="הַֽ֝" x-translit="ha" srcloc="WLC.PSA.119.1.004" x-head="true" lemma="הַ" strong="H1886a">Who</char> <char style="w" x-id="t011" x-align="PSA.119.1.a005" x-src="WLC.PSA.119.1.005" x-source="הֹלְכִ֗ים" x-translit="hōləḵiym" srcloc="WLC.PSA.119.1.005" x-head="true" lemma="הָלַךְ" strong="H1980">walk</char> <char style="w" x-id="t012" x-align="PSA.119.1.a006" x-src="WLC.PSA.119.1.006" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.119.1.006" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t013" x-align="PSA.119.1.a007">the</char> <char style="w" x-id="t014" x-align="PSA.119.1.a007" x-src="WLC.PSA.119.1.007" x-source="תוֹרַ֥ת" x-translit="ṯôraṯ" srcloc="WLC.PSA.119.1.007" x-head="true" lemma="תּוֹרָה" strong="H8451">law</char> <char style="w" x-id="t015" x-align="PSA.119.1.a008">of</char> <char style="w" x-id="t016" x-align="PSA.119.1.a008" x-src="WLC.PSA.119.1.008" x-source="יְהוָֽה" x-translit="yəhwāh:" srcloc="WLC.PSA.119.1.008" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>.<verse eid="PSA 119:1" /></para>
