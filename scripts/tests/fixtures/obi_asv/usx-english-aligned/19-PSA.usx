	<para style="s1"><verse number="1" style="v" sid="PSA 3:1" />Morning prayer of trust in God.</para>
	<para style="d" x-unrepresented-source="פְּנֵ֤י" x-unrepresented-translit="pənēy" x-unrepresented-src="WLC.PSA.3.0.008"><char style="w" x-id="t001" x-align="PSA.3.0.a001">A</char> <char style="w" x-id="t002" x-align="PSA.3.0.a001" x-src="WLC.PSA.3.0.001" x-source="מִזְמ֥וֹר" x-translit="mizmôr" srcloc="WLC.PSA.3.0.001" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t003" x-align="PSA.3.0.a002" x-src="WLC.PSA.3.0.002" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.3.0.002" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t004" x-align="PSA.3.0.a003" x-src="WLC.PSA.3.0.003" x-source="דָוִ֑ד" x-translit="ḏāwiḏ" srcloc="WLC.PSA.3.0.003" x-head="true" lemma="דָּוִד" strong="H1732">David</char>, <char style="w" x-id="t005" x-align="PSA.3.0.a004" x-src="WLC.PSA.3.0.004" x-source="בְּ֝" x-translit="bə" srcloc="WLC.PSA.3.0.004" x-head="true" lemma="בְּ" strong="H871a">when</char> <char style="w" x-id="t006" x-align="PSA.3.0.a006" x-src="WLC.PSA.3.0.006" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.3.0.006" x-head="true" lemma="הוּא" strong="H2050c">he</char> <char style="w" x-id="t007" x-align="PSA.3.0.a005" x-src="WLC.PSA.3.0.005" x-source="בָרְח֗" x-translit="ḇārəḥ" srcloc="WLC.PSA.3.0.005" x-head="true" lemma="בָּרַח" strong="H1272">fled</char> <char style="w" x-id="t008" x-align="PSA.3.0.a007" x-src="WLC.PSA.3.0.007" x-source="מִ" x-translit="mi" srcloc="WLC.PSA.3.0.007" x-head="true" lemma="מִן" strong="H4480">from</char> <char style="w" x-id="t009" x-align="PSA.3.0.a009" x-src="WLC.PSA.3.0.009" x-source="אַבְשָׁל֬וֹם" x-translit="ʾaḇšālôm" srcloc="WLC.PSA.3.0.009" x-head="true" lemma="אַבְשָׁלֹום" strong="H53">Absalom</char> <char style="w" x-id="t010" x-align="PSA.3.0.a011" x-src="WLC.PSA.3.0.011" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.3.0.011" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t011" x-align="PSA.3.0.a010" x-src="WLC.PSA.3.0.010" x-source="בְּנֽ" x-translit="bən" srcloc="WLC.PSA.3.0.010" x-head="true" lemma="בֵּן" strong="H1121">son</char>.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.3.1.a001" x-src="WLC.PSA.3.1.001" x-source="יְ֭הוָה" x-translit="yhwh" srcloc="WLC.PSA.3.1.001" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t002" x-align="PSA.3.1.a002" x-src="WLC.PSA.3.1.002" x-source="מָֽה" x-translit="māh-" srcloc="WLC.PSA.3.1.002" x-head="true" lemma="מָה" strong="H4100">how</char> <char style="w" x-id="t003" x-align="PSA.3.1.a003">are</char> <char style="w" x-id="t004" x-align="PSA.3.1.a005" x-src="WLC.PSA.3.1.005" x-source="י" x-translit="āy" srcloc="WLC.PSA.3.1.005" x-head="true" lemma="הוּא" strong="H2967a">mine</char> <char style="w" x-id="t005" x-align="PSA.3.1.a004" x-src="WLC.PSA.3.1.004" x-source="צָרָ֑" x-translit="ṣār" srcloc="WLC.PSA.3.1.004" x-head="true" lemma="צַר" strong="H6862a">adversaries</char> <char style="w" x-id="t006" x-align="PSA.3.1.a003" x-src="WLC.PSA.3.1.003" x-source="רַבּ֣וּ" x-translit="rabû" srcloc="WLC.PSA.3.1.003" x-head="true" lemma="רָבַב" strong="H7231">increased</char>!</para>
	<para style="q1"><char style="w" x-id="t007" x-align="PSA.3.1.a006" x-src="WLC.PSA.3.1.006" x-source="רַ֝בִּ֗ים" x-translit="rabbiym" srcloc="WLC.PSA.3.1.006" x-head="true" lemma="רַב" strong="H7227">Many</char> <char style="w" x-id="t008" x-align="PSA.3.1.a006">are</char> <char style="w" x-id="t009" x-align="PSA.3.1.a007">they</char> <char style="w" x-id="t010" x-align="PSA.3.1.a007">that</char> <char style="w" x-id="t011" x-align="PSA.3.1.a007" x-src="WLC.PSA.3.1.007" x-source="קָמִ֥ים" x-translit="qāmiym" srcloc="WLC.PSA.3.1.007" x-head="true" lemma="קוּם" strong="H6965">rise</char> <char style="w" x-id="t012" x-align="PSA.3.1.a007">up</char> <char style="w" x-id="t013" x-align="PSA.3.1.a008" x-src="WLC.PSA.3.1.008" x-source="עָלָֽ" x-translit="ʿāl" srcloc="WLC.PSA.3.1.008" x-head="true" lemma="עַל" strong="H5921">against</char> <char style="w" x-id="t014" x-align="PSA.3.1.a009" x-src="WLC.PSA.3.1.009" x-source="י" x-translit="āy" srcloc="WLC.PSA.3.1.009" x-head="true" lemma="הוּא" strong="H2967a">me</char>.<verse eid="PSA 3:1" /></para>
	<para style="q1"><verse number="2" style="v" x-unrepresented-source="ה" x-unrepresented-translit="āh" x-unrepresented-src="WLC.PSA.3.2.008" sid="PSA 3:2" /><char style="w" x-id="t001" x-align="PSA.3.2.a001" x-src="WLC.PSA.3.2.001" x-source="רַבִּים֮" x-translit="rabbîm" srcloc="WLC.PSA.3.2.001" x-head="true" lemma="רַב" strong="H7227">Many</char> <char style="w" x-id="t002" x-align="PSA.3.2.a002">there</char> <char style="w" x-id="t003" x-align="PSA.3.2.a002">are</char> <char style="w" x-id="t004" x-align="PSA.3.2.a002">that</char> <char style="w" x-id="t005" x-align="PSA.3.2.a002" x-src="WLC.PSA.3.2.002" x-source="אֹמְרִ֪ים" x-translit="ʾōməriym" srcloc="WLC.PSA.3.2.002" x-head="true" lemma="אָמַר" strong="H559">say</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">to</char></char></note><char style="w" x-id="t006" x-align="PSA.3.2.a003" x-src="WLC.PSA.3.2.003" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.3.2.003" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t007" x-align="PSA.3.2.a005" x-src="WLC.PSA.3.2.005" x-source="י" x-translit="iy" srcloc="WLC.PSA.3.2.005" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t008" x-align="PSA.3.2.a004" x-src="WLC.PSA.3.2.004" x-source="נַ֫פְשִׁ֥" x-translit="nap̄š" srcloc="WLC.PSA.3.2.004" x-head="true" lemma="נֶפֶשׁ" strong="H5315">soul</char>,</para>
