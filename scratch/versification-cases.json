[{"id": "tr-bulk", "cls": "absent", "title": "15 віршів Textus Receptus", "rows": 59, "trs": ["KJV", "NASB", "RST", "UBIO", "ASV"], "short": "оригіналу не існує", "verdict": "org = «-» — порожній «Оригінал» як рішення", "rec": "підписати оптом", "why": "Ці вірші є в Textus Receptus і відсутні в критичному тексті, з якого зроблено Macula. Зараз мапінг вказує на вірш, якого не існує: вкладка «Оригінал» порожня через дірку в даних, а не через рішення. Рядок org=«-» робить порожнечу свідомою і задокументованою.", "check": "Колонка «в Macula» має бути «немає» в усіх 15 рядках. Якщо десь «є» — це не TR-вірш і його не можна підписувати цим класом.", "items": [{"ref": "MAT 17:21", "trs": ["KJV", "NASB", "RST", "UBIO"], "text": "Howbeit this kind goeth not out but by prayer and fasting.", "orgExists": false}, {"ref": "MAT 18:11", "trs": ["KJV", "NASB", "RST", "UBIO"], "text": "For the Son of man is come to save that which was lost.", "orgExists": false}, {"ref": "MAT 23:14", "trs": ["KJV", "NASB", "RST", "UBIO"], "text": "Woe unto you, scribes and Pharisees, hypocrites! for ye devour widows' houses, and for a pretence make long prayer: therefore ye shall receive the greater damnation.", "orgExists": false}, {"ref": "MRK 7:16", "trs": ["KJV", "NASB", "RST", "UBIO"], "text": "If any man have ears to hear, let him hear.", "orgExists": false}, {"ref": "MRK 9:44", "trs": ["KJV", "NASB", "RST", "UBIO"], "text": "Where their worm dieth not, and the fire is not quenched.", "orgExists": false}, {"ref": "MRK 9:46", "trs": ["KJV", "NASB", "RST", "UBIO"], "text": "Where their worm dieth not, and the fire is not quenched.", "orgExists": false}, {"ref": "MRK 11:26", "trs": ["KJV", "NASB", "RST", "UBIO"], "text": "But if ye do not forgive, neither will your Father which is in heaven forgive your trespasses.", "orgExists": false}, {"ref": "MRK 15:28", "trs": ["KJV", "NASB", "RST", "UBIO"], "text": "And the scripture was fulfilled, which saith, And he was numbered with the transgressors.", "